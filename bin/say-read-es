#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_HELPER="$SCRIPT_DIR/linux-speech-tools-env"
if [ -f "$ENV_HELPER" ]; then
    # shellcheck disable=SC1090
    source "$ENV_HELPER"
fi
PROJECT_ROOT="${LST_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
if [ ! -f "$PROJECT_ROOT/pyproject.toml" ] && [ -f "/usr/share/linux-speech-tools/pyproject.toml" ]; then
    PROJECT_ROOT="/usr/share/linux-speech-tools"
fi

for arg in "$@"; do
    case "$arg" in
        -h|--help|help)
            exec "$SCRIPT_DIR/say-read" --help
            ;;
    esac
done

echo "Warning: say-read-es is deprecated. Use 'say-read -l es -v ef_dora' instead." >&2
exec "$SCRIPT_DIR/say-read" -l es -v ef_dora "$@"
