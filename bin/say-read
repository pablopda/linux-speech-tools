#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_HELPER="$SCRIPT_DIR/linux-speech-tools-env"
if [ -f "$ENV_HELPER" ]; then
    # shellcheck disable=SC1090
    source "$ENV_HELPER"
fi
PROJECT_ROOT="${LST_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
if [ ! -f "$PROJECT_ROOT/pyproject.toml" ] && [ -f "/usr/share/linux-speech-tools/pyproject.toml" ]; then
    PROJECT_ROOT="/usr/share/linux-speech-tools"
fi

if [ ! -f "$PROJECT_ROOT/src/tts/say_read.py" ]; then
    echo "Error: src/tts/say_read.py not found." >&2
    echo "Set LST_PROJECT_ROOT or reinstall with ./installer.sh --with-kokoro." >&2
    exit 1
fi

cd "$PROJECT_ROOT"

extra_args=(--max-chars "${SAYREAD_MAXCHARS:-6000}")
use_stream_fast=true
user_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help|help)
            echo "Installed say-read defaults: --max-chars ${SAYREAD_MAXCHARS:-6000} --stream-fast" >&2
            user_args+=("$1")
            shift
            ;;
        --stream|--stream-fast|--out|-o|--player)
            use_stream_fast=false
            user_args+=("$1")
            shift
            ;;
        --original)
            use_stream_fast=false
            shift
            ;;
        --continuous)
            use_stream_fast=true
            shift
            ;;
        *)
            user_args+=("$1")
            shift
            ;;
    esac
done

if [ "$use_stream_fast" = true ]; then
    extra_args+=(--stream-fast)
fi

exec uv --project "$PROJECT_ROOT" run --extra kokoro --extra read python src/tts/say_read.py \
    "${extra_args[@]}" "${user_args[@]}"
