#!/usr/bin/env bash
set -euo pipefail

# Script-local helper must be loaded before defaults so install.env can
# override documented runtime settings without executing arbitrary shell.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_HELPER="$SCRIPT_DIR/linux-speech-tools-env"
if [ -f "$ENV_HELPER" ]; then
  # shellcheck disable=SC1090
  source "$ENV_HELPER"
fi

# Defaults
STT_VENV="${STT_VENV:-$HOME/.venvs/stt}"
WHISPER_MODEL="${WHISPER_MODEL:-large-v3}"
ASR_LANG="${ASR_LANG:-en}"        # "auto" to auto-detect
MODE="clipboard"                  # or "type"; legacy paste is explicit opt-in
SEND_ENTER=0
DUR="${DUR:-8}"
PASTE_DELAY="${PASTE_DELAY:-0.35}"
CLIPBOARD_ONLY=1

# Absolute paths
YDO="${YDO:-$(command -v ydotool || echo /usr/bin/ydotool)}"
WLCOPY="$(command -v wl-copy || true)"
XCLIP="$(command -v xclip || true)"
NOTIFY="$(command -v notify-send || true)"   # sudo apt install libnotify-bin

ffmpeg_supports_input_format() {
  local executable="$1"
  local input_format="$2"
  [ -x "$executable" ] || return 1
  "$executable" -hide_banner -formats 2>/dev/null | awk '{print $2}' | grep -qx "$input_format"
}

choose_ffmpeg() {
  local exe
  if [ -n "${FFM:-}" ]; then
    printf '%s\n' "$FFM"
    return 0
  fi
  if [ -n "${STT_FFMPEG:-}" ]; then
    printf '%s\n' "$STT_FFMPEG"
    return 0
  fi
  for exe in /usr/bin/ffmpeg "$(command -v ffmpeg 2>/dev/null || true)"; do
    if ffmpeg_supports_input_format "$exe" pulse; then
      printf '%s\n' "$exe"
      return 0
    fi
  done
  command -v ffmpeg 2>/dev/null || echo /usr/bin/ffmpeg
}

FFM="$(choose_ffmpeg)"

PROJECT_ROOT="${LST_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
if [ ! -f "$PROJECT_ROOT/pyproject.toml" ] && [ -f "/usr/share/linux-speech-tools/pyproject.toml" ]; then
    PROJECT_ROOT="/usr/share/linux-speech-tools"
fi

# Stable private runtime dir
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  RDIR="$XDG_RUNTIME_DIR/linux-speech-tools/t2c"
else
  RDIR="${XDG_STATE_HOME:-$HOME/.local/state}/linux-speech-tools/t2c"
fi
PID="$RDIR/ffmpeg.pid"
WAV="$RDIR/clip.wav"
LOG="$RDIR/rec.log"
mkdir -p "$RDIR"
chmod 700 "$RDIR" 2>/dev/null || true

usage(){
local code="${1:-2}"
local out="/dev/stderr"
if [ "$code" -eq 0 ]; then
  out="/dev/stdout"
fi
cat >"$out" <<EOF
usage: talk2claude [subcommand] [options]

[no args] => record ${DUR}s, transcribe, copy to clipboard
Subcommands:
  toggle        start if idle; else stop + transcribe + (copy+paste)
  start         start background recording
  stop          stop recording; transcribe; (copy+paste)
  status        show recorder status
Options:
  -l, --lang CODE|auto
  -m, --model NAME
      --type               type directly instead of copying to clipboard
      --paste              paste via ydotool after copying to clipboard
      --enter              press Enter after inserting
      --time SECONDS       one-shot duration
      --clipboard-only     copy text to clipboard, don’t paste
      --paste-delay SEC    delay before Ctrl+V
Env:
  T2C_ALLOW_PASTE_IN_TERMINAL=1  # allow paste mode when run inside a terminal
EOF
exit "$code"; }

require_value() {
  local option="$1"
  if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
    echo "Error: $option requires a value" >&2
    usage 2
  fi
}

# --- helpers ---
alive(){ kill -0 "$1" 2>/dev/null; }
beep(){ canberra-gtk-play --id="$1" >/dev/null 2>&1 || true; }
note(){ [ -n "$NOTIFY" ] && "$NOTIFY" "$@"; }

ensure_socket(){
  # choose socket path without compound tests
  local sock=""
  if [ -n "${YDOTOOL_SOCKET:-}" ] && [ -S "$YDOTOOL_SOCKET" ]; then
    sock="$YDOTOOL_SOCKET"
  elif [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/.ydotool_socket" ]; then
    sock="$XDG_RUNTIME_DIR/.ydotool_socket"
  fi
  if [ -n "$sock" ]; then
    export YDOTOOL_SOCKET="$sock"
    return 0
  fi
  return 1
}

copy_to_clipboard(){
  # prefer wl-clipboard; fallback xclip
  if [ -n "$WLCOPY" ]; then
    printf '%s' "$1" | "$WLCOPY"
    return 0
  elif [ -n "$XCLIP" ]; then
    printf '%s' "$1" | "$XCLIP" -selection clipboard
    return 0
  fi
  return 1
}

do_insert(){
  local text="$1"
  local copied=0
  if copy_to_clipboard "$text"; then
    copied=1
  fi

  if [ "$CLIPBOARD_ONLY" -eq 1 ]; then
    if [ "$copied" -eq 1 ]; then
      note "Dictation" "Copied to clipboard. Press Ctrl+V to paste."
      return 0
    fi
    note "Dictation" "Clipboard tool missing; transcription printed in terminal."
    printf '%s\n' "$text"
    return 1
  fi
  if ! ensure_socket; then
    if [ "$copied" -eq 1 ]; then
      note "Dictation" "Copied to clipboard (no auto-paste: ydotool socket missing)."
      return 0
    fi
    note "Dictation" "No clipboard or ydotool socket available."
    printf '%s\n' "$text"
    return 1
  fi

  if [ "$MODE" = "paste" ] && [ "$copied" -eq 1 ]; then
    sleep "$PASTE_DELAY"
    # Ctrl+V (silenced)
    "$YDO" key 29:1 47:1 47:0 29:0 >/dev/null 2>&1
  else
    "$YDO" type "$text" >/dev/null 2>&1
  fi
  if [ "$SEND_ENTER" -eq 1 ]; then
    "$YDO" key 28:1 28:0 >/dev/null 2>&1
  fi
}

start_rec(){
  # clean stale pid
  if [ -f "$PID" ]; then
    local p; p="$(cat "$PID" 2>/dev/null || true)"
    if [ -z "${p:-}" ] || ! alive "$p"; then rm -f "$PID"; fi
  fi
  if [ -f "$PID" ]; then
    note "Dictation" "Already recording."
    return 0
  fi
  rm -f "$WAV"
  beep audio-input-start
  note "Dictation" "Recording… Press the shortcut again to stop."
  "$FFM" -nostdin -f pulse -i default -ac 1 -ar 16000 -c:a pcm_s16le -y "$WAV" >"$LOG" 2>&1 &
  echo $! > "$PID"
}

stop_rec(){
  # return 1 if not recording (so toggle knows to start)
  if [ ! -f "$PID" ]; then
    return 1
  fi
  local p; p="$(cat "$PID" 2>/dev/null || true)"
  if [ -z "${p:-}" ] || ! alive "$p"; then rm -f "$PID"; return 1; fi
  note "Dictation" "Stopping… (finalizing audio)"
  kill -INT "$p" 2>/dev/null || true
  # wait up to ~3s for ffmpeg to exit
  local i=0
  while [ $i -lt 30 ]; do
    if ! alive "$p"; then break; fi
    sleep 0.1
    i=$((i+1))
  done
  if alive "$p"; then kill -TERM "$p" 2>/dev/null || true; sleep 0.2; fi
  if alive "$p"; then kill -KILL "$p" 2>/dev/null || true; fi
  rm -f "$PID"
  sleep 0.15
  beep audio-input-stop
}

transcribe_and_insert(){
  if [ ! -s "$WAV" ]; then
    note "Dictation" "No audio captured."
    return 1
  fi
  local py_cmd=()
  if [ -x "$STT_VENV/bin/python" ]; then
    py_cmd=("$STT_VENV/bin/python")
  elif command -v uv >/dev/null 2>&1 && [ -f "$PROJECT_ROOT/pyproject.toml" ]; then
    py_cmd=(uv --project "$PROJECT_ROOT" run --extra stt python)
  else
    note "Dictation" "Error: STT dependencies missing. Run installer.sh --with-stt."
    return 1
  fi
  note "Dictation" "Transcribing…"
  # run Whisper
  local txt
  txt="$("${py_cmd[@]}" - <<'PY' "$WAV" "$WHISPER_MODEL" "$ASR_LANG"
import sys, re
from faster_whisper import WhisperModel
audio, model_name, lang_in = sys.argv[1], sys.argv[2], sys.argv[3]
code = (lang_in or "").strip().lower()
code = re.split(r'[._-]', code)[0] if code else ""
lang = None if code in ("", "auto") else code
m = WhisperModel(model_name, device="cpu", compute_type="int8")
segments, info = m.transcribe(audio, beam_size=5, language=lang)
print(" ".join(s.text.strip() for s in segments).strip())
PY
)"
  if [ -z "${txt// }" ]; then
    note "Dictation" "No speech recognized."
    return 1
  fi
  if [ "$CLIPBOARD_ONLY" -eq 1 ]; then
    note "Dictation" "Ready. Copying to clipboard…"
  elif [ "$MODE" = "type" ]; then
    note "Dictation" "Ready. Typing into active window…"
  else
    note "Dictation" "Ready. Pasting in ${PASTE_DELAY}s…"
  fi
  do_insert "$txt"
  note "Dictation" "Done."
  rm -f "$WAV"
}

one_shot(){
  "$FFM" -nostdin -f pulse -i default -t "$DUR" -ac 1 -ar 16000 -c:a pcm_s16le -y "$WAV" -loglevel error
  transcribe_and_insert
}

# --- parse args (support flags before/after subcommand) ---
CMD=""
while [ $# -gt 0 ]; do
  case "$1" in
    toggle|start|stop|status) CMD="$1"; shift ;;
    -l|--lang)  require_value "$1" "${2:-}"; ASR_LANG="$2"; shift 2 ;;
    -m|--model) require_value "$1" "${2:-}"; WHISPER_MODEL="$2"; shift 2 ;;
    --type)     MODE="type"; CLIPBOARD_ONLY=0; shift ;;
    --paste)    MODE="paste"; CLIPBOARD_ONLY=0; shift ;;
    --enter)    SEND_ENTER=1; shift ;;
    --time)     require_value "$1" "${2:-}"; DUR="$2"; shift 2 ;;
    --clipboard-only) CLIPBOARD_ONLY=1; shift ;;
    --paste-delay)    require_value "$1" "${2:-}"; PASTE_DELAY="$2"; shift 2 ;;
    -h|--help)  usage 0 ;;
    --) shift; break ;;
    -*)
        echo "Error: unknown option: $1" >&2
        usage 2
        ;;
    *)
        echo "Error: unexpected argument: $1" >&2
        usage 2
        ;;
  esac
done

# Extra guard for explicit paste/type when invoked from a terminal.
if [ -t 1 ] && [ -z "${T2C_ALLOW_PASTE_IN_TERMINAL:-}" ] && [ "$CLIPBOARD_ONLY" -eq 0 ]; then
  MODE="clipboard"
  CLIPBOARD_ONLY=1
fi

# --- main ---
case "${CMD:-}" in
  toggle)
    if stop_rec; then
      transcribe_and_insert
    else
      start_rec
    fi
    ;;
  start)  start_rec ;;
  stop)   stop_rec && transcribe_and_insert ;;
  status) if [ -f "$PID" ]; then echo "[t2c] recording (pid $(cat "$PID"))"; else echo "[t2c] idle"; fi ;;
  "")     one_shot ;;
  *)      usage ;;
esac
