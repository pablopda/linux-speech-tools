#!/usr/bin/env bash
# Compatibility wrapper. The maintained say-read command now owns streaming and
# canonical chunking behavior.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="$SCRIPT_DIR/say-read"
if [ ! -x "$TARGET" ] && [ -x "/usr/share/linux-speech-tools/bin/say-read" ]; then
    TARGET="/usr/share/linux-speech-tools/bin/say-read"
fi
if [ ! -x "$TARGET" ]; then
    echo "Error: say-read not found next to say-read-mvp." >&2
    exit 1
fi

for arg in "$@"; do
    case "$arg" in
        -h|--help|help)
            exec "$TARGET" --help
            ;;
    esac
done

echo "Warning: say-read-mvp is deprecated. Use 'say-read' instead." >&2
exec "$TARGET" "$@"
