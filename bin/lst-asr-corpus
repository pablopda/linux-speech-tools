#!/usr/bin/env bash
# lst-asr-corpus - private, resumable LATAM ASR corpus acquisition.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_HELPER="$SCRIPT_DIR/linux-speech-tools-env"
if [ -f "$ENV_HELPER" ]; then
    # shellcheck disable=SC1090
    source "$ENV_HELPER"
fi
PROJECT_ROOT="${LST_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
if [ ! -f "$PROJECT_ROOT/src/utils/asr_corpus_acquisition.py" ] && \
   [ -f "/usr/share/linux-speech-tools/src/utils/asr_corpus_acquisition.py" ]; then
    PROJECT_ROOT="/usr/share/linux-speech-tools"
fi

if [ ! -f "$PROJECT_ROOT/src/utils/asr_corpus_acquisition.py" ]; then
    printf '%s\n' "Error: could not find the corpus acquisition runtime." >&2
    printf '%s\n' "Set LST_PROJECT_ROOT or reinstall Linux Speech Tools." >&2
    exit 1
fi
if ! command -v uv >/dev/null 2>&1; then
    printf '%s\n' "Error: uv is required." >&2
    exit 1
fi

cd "$PROJECT_ROOT"
exec uv --project "$PROJECT_ROOT" run --locked \
    python -m src.utils.asr_corpus_acquisition "$@"
