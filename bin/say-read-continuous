#!/usr/bin/env bash
# Compatibility wrapper. say-read now uses low-latency streaming by default.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for arg in "$@"; do
    case "$arg" in
        -h|--help|help)
            exec "$SCRIPT_DIR/say-read" --help
            ;;
    esac
done
echo "Warning: say-read-continuous is deprecated. Use 'say-read' instead." >&2
exec "$SCRIPT_DIR/say-read" "$@"
