#!/usr/bin/env bash
# GNOME Speech-to-Clipboard Integration
# Enhanced wrapper around talk2claude with GNOME-specific features

set -euo pipefail

# GNOME-specific paths and tools
MEDIA_KEYS_SCHEMA="org.gnome.settings-daemon.plugins.media-keys"
DICTATION_BINDING_PATH="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/dictation/"

# Path to talk2claude
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_HELPER="$SCRIPT_DIR/linux-speech-tools-env"
if [ -f "$ENV_HELPER" ]; then
    # shellcheck disable=SC1090
    source "$ENV_HELPER"
fi
TALK2CLAUDE="$(dirname "$0")/talk2claude"
TALK2CLAUDE_FASTER="$(dirname "$0")/talk2claude-faster"
TALK2CLAUDE_FASTER_TOGGLE="$(dirname "$0")/talk2claude-faster-toggle"

faster_state_dir() {
    if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        printf '%s\n' "$XDG_RUNTIME_DIR/linux-speech-tools"
    else
        printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/linux-speech-tools"
    fi
}

faster_is_recording() {
    local pid_file pid
    pid_file="$(faster_state_dir)/talk2claude-faster.pid"
    [ -f "$pid_file" ] || return 1
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ ]] && pid_is_faster_dictation "$pid"; then
        return 0
    fi
    rm -f "$pid_file"
    return 1
}

pid_is_faster_dictation() {
    local pid="$1"
    local uid cmdline

    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    uid="$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')"
    [ "$uid" = "$(id -u)" ] || return 1
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline")"
    [[ "$cmdline" =~ faster_whisper_(auto|clipboard|typing) ]] || return 1
}

update_keybinding_list() {
    local action="$1"
    local path="$2"
    local current
    current="$(gsettings get "$MEDIA_KEYS_SCHEMA" custom-keybindings 2>/dev/null || echo "[]")"
    python3 - "$current" "$path" "$action" <<'PY'
import ast
import sys

current, path, action = sys.argv[1:]
current = current.replace("@as ", "")
try:
    values = ast.literal_eval(current)
except Exception:
    values = []
if not isinstance(values, list):
    values = []
if action == "add" and path not in values:
    values.append(path)
elif action == "remove":
    values = [value for value in values if value != path]
print("[" + ", ".join(repr(value) for value in values) + "]")
PY
}

# GNOME notification with custom icon and actions
gnome_notify() {
    local title="$1"
    local message="$2"
    local icon="${3:-audio-input-microphone-symbolic}"
    local urgency="${4:-normal}"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send \
            --icon="$icon" \
            --urgency="$urgency" \
            --app-name="Speech Dictation" \
            --category="im.received" \
            "$title" "$message"
    else
        printf '%s: %s\n' "$title" "$message" >&2
    fi
}

# Show status in GNOME notification area
show_status() {
    local format="${1:-}"
    case "$format" in
        --plain|--json)
            if [ -x "$TALK2CLAUDE_FASTER_TOGGLE" ]; then
                "$TALK2CLAUDE_FASTER_TOGGLE" status "$format"
                return
            fi
            if [ "$format" = "--plain" ]; then
                if faster_is_recording; then
                    echo "listening"
                else
                    echo "idle"
                fi
                return
            fi
            python3 - "$(faster_state_dir)" "$(faster_is_recording && echo 1 || echo 0)" <<'PY'
import json
import sys
import time

state_dir, running = sys.argv[1:]
print(json.dumps({
    "state": "listening" if running == "1" else "idle",
    "mode": "clipboard",
    "pid": None,
    "pid_file": f"{state_dir}/talk2claude-faster.pid",
    "log_file": f"{state_dir}/talk2claude-faster.log",
    "fallback_file": f"{state_dir}/dictation.txt",
    "updated_at": int(time.time()),
}, sort_keys=True))
PY
            return
            ;;
        "")
            ;;
        *)
            echo "unknown status option: $format" >&2
            return 2
            ;;
    esac

    if faster_is_recording; then
        gnome_notify "🎙️ Dictation" "Recording in progress... Press hotkey again to stop and transcribe" "audio-input-microphone-symbolic"
    else
        gnome_notify "💬 Dictation" "Ready for voice input. Press hotkey to start recording" "audio-input-microphone-symbolic"
    fi
}

# Enhanced toggle with GNOME feedback (uses talk2claude-faster-toggle)
toggle_with_feedback() {
    if [ -x "$TALK2CLAUDE_FASTER_TOGGLE" ]; then
        "$TALK2CLAUDE_FASTER_TOGGLE"
    else
        # Fallback to legacy talk2claude, which is the backend for this path and
        # reports its own "recording"/"idle" status. (The normalized
        # "listening"/"idle" vocabulary is exposed via `status --plain`, which is
        # what the extension and other scripts should consume.)
        if "$TALK2CLAUDE" status | grep -q "recording"; then
            gnome_notify "🔄 Processing" "Stopping recording and transcribing..." "audio-input-microphone-symbolic"
            "$TALK2CLAUDE" stop
        else
            gnome_notify "🎙️ Recording" "Listening... Speak now!" "audio-input-microphone-high-symbolic" "low"
            "$TALK2CLAUDE" start
        fi
    fi
}

# Quick one-shot with duration
quick_dictate() {
    local duration="${1:-5}"
    gnome_notify "⚡ Quick Dictate" "Recording for ${duration}s... Speak now!" "audio-input-microphone-high-symbolic" "low"
    if [ -x "$TALK2CLAUDE_FASTER" ] && command -v timeout >/dev/null 2>&1; then
        set +e
        timeout --signal=INT "${duration}s" "$TALK2CLAUDE_FASTER" --clipboard
        local rc=$?
        set -e
        if [ "$rc" -ne 0 ] && [ "$rc" -ne 124 ] && [ "$rc" -ne 130 ]; then
            gnome_notify "Dictation Failed" "Quick dictation exited with code $rc" "dialog-error" "critical"
            return "$rc"
        fi
    else
        DUR="$duration" "$TALK2CLAUDE" --clipboard-only
    fi
}

purge_state() {
    if [ -x "$TALK2CLAUDE_FASTER_TOGGLE" ]; then
        "$TALK2CLAUDE_FASTER_TOGGLE" purge-state
    elif [ -x "$TALK2CLAUDE_FASTER" ]; then
        "$TALK2CLAUDE_FASTER" --purge-state
    else
        echo "talk2claude-faster-toggle not found" >&2
        return 1
    fi
}

# Setup GNOME keyboard shortcut
setup_gnome_shortcut() {
    local script_path
    local toggle_path
    script_path="$(realpath "$0")"

    echo "🔧 Setting up GNOME speech-to-clipboard integration..."

    if [ -z "${XDG_CURRENT_DESKTOP:-}" ] || [[ ! "$XDG_CURRENT_DESKTOP" =~ GNOME ]]; then
        echo "Error: not a GNOME session (XDG_CURRENT_DESKTOP='${XDG_CURRENT_DESKTOP:-}'); run setup inside GNOME" >&2
        return 1
    fi
    if ! command -v gsettings >/dev/null 2>&1; then
        echo "Error: gsettings not found; run setup in a GNOME desktop session" >&2
        return 1
    fi
    if ! gsettings list-schemas 2>/dev/null | grep -qx "$MEDIA_KEYS_SCHEMA"; then
        echo "Error: GSettings schema '$MEDIA_KEYS_SCHEMA' not found; gnome-settings-daemon may be missing" >&2
        return 1
    fi
    if [ ! -x "$TALK2CLAUDE_FASTER_TOGGLE" ]; then
        echo "Error: talk2claude-faster-toggle not found next to $script_path" >&2
        return 1
    fi
    toggle_path="$(realpath "$TALK2CLAUDE_FASTER_TOGGLE")"

    # Add custom keybinding without replacing unrelated shortcuts.
    gsettings set "$MEDIA_KEYS_SCHEMA" custom-keybindings "$(update_keybinding_list add "$DICTATION_BINDING_PATH")"

    # Configure the shortcut
    gsettings set "$MEDIA_KEYS_SCHEMA.custom-keybinding:$DICTATION_BINDING_PATH" name "Speech Dictation (Toggle)"
    gsettings set "$MEDIA_KEYS_SCHEMA.custom-keybinding:$DICTATION_BINDING_PATH" command "$toggle_path"
    gsettings set "$MEDIA_KEYS_SCHEMA.custom-keybinding:$DICTATION_BINDING_PATH" binding "<Control><Alt>v"

    echo "✅ Setup complete!"
    echo "   Hotkey: Ctrl+Alt+V"
    echo "   Press once to start recording, again to stop and transcribe"
    echo ""
    echo "Quick test commands:"
    echo "  $toggle_path status --plain # Check status"
    echo "  $script_path quick 3   # 3-second quick dictation"
    echo "  $toggle_path           # Start/stop recording"
}

# Show usage
show_usage() {
    cat << EOF
GNOME Speech-to-Clipboard Integration

Usage:
  $(basename "$0") [command] [options]

Commands:
  toggle          Toggle recording (default - start if idle, stop if recording)
  quick [secs]    Quick dictation for specified seconds (default: 5)
  status [format] Show current recording status; use --plain or --json for scripts
  purge-state     Remove stopped STT state files and logs
  setup           Install GNOME keyboard shortcut (Ctrl+Alt+V)

Examples:
  $(basename "$0")              # Toggle recording
  $(basename "$0") quick 3      # Quick 3-second dictation
  $(basename "$0") setup        # Setup system hotkey

Environment variables:
  WHISPER_MODEL=base       # Faster-whisper model
  ASR_LANG=en              # Language, or auto
  DICTATION_MODE=clipboard # Clipboard default; typing is explicit opt-in
  DICTATION_PREVIEW=1      # Preview before copying or typing
  STT_TRANSCRIPT_FALLBACK=1 # Opt in to private file fallback when no clipboard tool exists
EOF
}

# Main function
case "${1:-toggle}" in
    "toggle"|"")     toggle_with_feedback ;;
    "quick")         quick_dictate "${2:-5}" ;;
    "status")        show_status "${2:-}" ;;
    "purge-state"|"purge") purge_state ;;
    "setup")         setup_gnome_shortcut ;;
    "help"|"-h"|"--help") show_usage ;;
    *)
        echo "Error: unknown command: $1" >&2
        show_usage >&2
        exit 2
        ;;
esac
