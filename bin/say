#!/usr/bin/env bash
set -euo pipefail
# Linux Speech Tools - say command
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_HELPER="$SCRIPT_DIR/linux-speech-tools-env"
if [ -f "$ENV_HELPER" ]; then
    # shellcheck disable=SC1090
    source "$ENV_HELPER"
fi

# Use EDGE_VOICE (not VOICE) so it never collides with Kokoro settings.
VOICE="${EDGE_VOICE:-en-US-EmmaMultilingualNeural}"

# Version information
VERSION="1.0.2"
PROJECT_ROOT="${LST_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
if [ ! -f "$PROJECT_ROOT/pyproject.toml" ] && [ -f "/usr/share/linux-speech-tools/pyproject.toml" ]; then
    PROJECT_ROOT="/usr/share/linux-speech-tools"
fi
# Prefer the packaged VERSION file when present (repo root or install dir).
for _vf in "$PROJECT_ROOT/VERSION" "$SCRIPT_DIR/VERSION"; do
    if [ -f "$_vf" ]; then
        VERSION="$(tr -d '[:space:]' < "$_vf")"
        break
    fi
done

show_help() {
    cat << EOF
usage: say [options] "text..."

Text-to-speech using Edge TTS (cloud service).
For local/offline speech, use say-local or say-read.

Options:
  -v voice     Voice to use (default: en-US-EmmaMultilingualNeural)
  -o output    Output file (.mp3 or .wav)
  -h, --help   Show this help message
  --version    Show version information

Examples:
  say "Hello world"
  say -v es-ES-AlvaroNeural "Hola mundo"
  say -o greeting.mp3 "Welcome to Linux Speech Tools"
EOF
}

OUT=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -v)
            if [ $# -lt 2 ]; then
                echo "Error: -v requires a voice value" >&2
                echo "Try 'say --help' for more information." >&2
                exit 2
            fi
            VOICE="$2"
            shift 2
            ;;
        -o)
            if [ $# -lt 2 ]; then
                echo "Error: -o requires an output file" >&2
                echo "Try 'say --help' for more information." >&2
                exit 2
            fi
            OUT="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        --version)
            echo "say (Linux Speech Tools) v$VERSION"
            exit 0
            ;;
        -*)
            echo "unknown option: $1" >&2
            echo "Try 'say --help' for more information." >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done
[ $# -gt 0 ] || {
    echo "Error: No text provided" >&2
    echo "Try 'say --help' for more information." >&2
    exit 2
}
TEXT="$*"

if ! command -v uv >/dev/null 2>&1 || [ ! -f "$PROJECT_ROOT/pyproject.toml" ]; then
  echo "Error: uv project environment not found." >&2
  echo "Run ./installer.sh or set LST_PROJECT_ROOT to this checkout." >&2
  exit 1
fi

edge_tts=(uv --project "$PROJECT_ROOT" run edge-tts)
edge_playback=(uv --project "$PROJECT_ROOT" run edge-playback)

if [ -n "$OUT" ]; then
  OUT_DIR="$(dirname -- "$OUT")"
  if [ ! -d "$OUT_DIR" ]; then
    echo "Error: output directory does not exist: $OUT_DIR" >&2
    exit 1
  fi
  if [ -e "$OUT" ]; then
    echo "Warning: overwriting existing file: $OUT" >&2
  fi
  "${edge_tts[@]}" --voice "$VOICE" --text "$TEXT" --write-media "$OUT"
  echo "Wrote $OUT"
else
  if "${edge_playback[@]}" --help >/dev/null 2>&1; then
    "${edge_playback[@]}" --voice "$VOICE" --text "$TEXT"
  else
    TMP="$(mktemp --suffix=.mp3)"
    cleanup() { rm -f "$TMP"; }
    trap cleanup EXIT
    "${edge_tts[@]}" --voice "$VOICE" --text "$TEXT" --write-media "$TMP"
    if command -v ffplay >/dev/null 2>&1; then
      ffplay -hide_banner -loglevel error -nodisp -autoexit "$TMP"
    elif command -v mpv >/dev/null 2>&1; then
      mpv --no-video --really-quiet "$TMP"
    else
      echo "No audio player found. Use -o to save output." >&2
      exit 1
    fi
  fi
fi
