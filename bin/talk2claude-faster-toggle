#!/usr/bin/env bash
# Toggle script for talk2claude-faster. Defaults to clipboard mode.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_HELPER="$SCRIPT_DIR/linux-speech-tools-env"
if [ -f "$ENV_HELPER" ]; then
    # shellcheck disable=SC1090
    source "$ENV_HELPER"
fi
PROJECT_ROOT="${LST_PROJECT_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
if [ ! -f "$PROJECT_ROOT/pyproject.toml" ] && [ -f "/usr/share/linux-speech-tools/pyproject.toml" ]; then
    PROJECT_ROOT="/usr/share/linux-speech-tools"
fi

if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    STATE_DIR="$XDG_RUNTIME_DIR/linux-speech-tools"
else
    STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/linux-speech-tools"
fi
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true
umask 077

# PID file to track running instance
PID_FILE="$STATE_DIR/talk2claude-faster.pid"
LOG_FILE="$STATE_DIR/talk2claude-faster.log"
DICTATION_FILE="$STATE_DIR/dictation.txt"
STATUS_FILE="$STATE_DIR/talk2claude-faster.status.json"

usage() {
    cat <<EOF
usage: talk2claude-faster-toggle [status [--plain|--json]|purge-state|-h|--help]

Toggle faster-whisper dictation in clipboard mode.

Commands:
  status      Print recording status without starting or stopping
  purge-state Remove stopped STT state files and logs
  -h, --help  Show this help
EOF
}

notify_msg() {
    local title="$1"
    local message="$2"
    local icon="${3:-dialog-information}"
    local urgency="${4:-low}"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$message" --icon="$icon" --urgency="$urgency"
    else
        printf '%s: %s\n' "$title" "$message" >&2
    fi
}

pid_is_ours() {
    local pid="$1"
    local uid
    local cmdline

    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1

    uid="$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')"
    [ "$uid" = "$(id -u)" ] || return 1

    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    [ -n "$cmdline" ] || return 1
    [[ "$cmdline" =~ faster_whisper_(auto|clipboard|typing) ]] || return 1
    if [[ "$cmdline" == *"$PROJECT_ROOT"* ]]; then
        return 0
    fi
    [ "$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)" = "$PROJECT_ROOT" ] || return 1
}

running_pid() {
    local pid
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE" 2>/dev/null || echo "")"
        if [ -n "$pid" ] && pid_is_ours "$pid"; then
            printf '%s\n' "$pid"
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

status_json() {
    local pid="${1:-}"
    local running="${2:-0}"
    if ! command -v python3 >/dev/null 2>&1; then
        # Minimal fallback so status still works without python3.
        if [ "$running" = "1" ]; then
            printf '{"state": "listening", "pid": %s}\n' "${pid:-null}"
        else
            printf '{"state": "idle", "pid": null}\n'
        fi
        return 0
    fi
    python3 - "$STATUS_FILE" "$PID_FILE" "$LOG_FILE" "$DICTATION_FILE" "$pid" "$running" <<'PY'
import json
import os
import sys
import time

status_file, pid_file, log_file, fallback_file, pid, running = sys.argv[1:]
try:
    with open(status_file, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    data = {}
if not isinstance(data, dict):
    data = {}

is_running = running == "1"
if is_running:
    if data.get("state") not in {"listening", "recording", "processing", "finalizing"}:
        data["state"] = "listening"
    try:
        data["pid"] = int(pid)
    except ValueError:
        data["pid"] = pid
else:
    if data.get("state") != "error":
        data["state"] = "idle"
        data["pid"] = None

data.setdefault("mode", "clipboard")
data["pid_file"] = pid_file
data["log_file"] = log_file
data["fallback_file"] = fallback_file
data["transcript_fallback_enabled"] = os.environ.get("STT_TRANSCRIPT_FALLBACK", "").lower() in {
    "1",
    "true",
    "yes",
    "on",
}
data.setdefault("updated_at", int(time.time()))
print(json.dumps(data, sort_keys=True))
PY
}

status_plain() {
    local pid="${1:-}"
    local running="${2:-0}"
    if ! command -v python3 >/dev/null 2>&1; then
        if [ "$running" = "1" ]; then echo "listening"; else echo "idle"; fi
        return 0
    fi
    status_json "$pid" "$running" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("state", "idle"))'
}

purge_state() {
    local pid
    pid="$(running_pid || true)"
    if [ -n "$pid" ]; then
        echo "dictation is running (pid $pid); stop it before purging state" >&2
        return 1
    fi
    rm -f "$PID_FILE" "$LOG_FILE" "$DICTATION_FILE" "$STATUS_FILE"
    echo "purged STT state from $STATE_DIR"
}

finalization_wait_polls() {
    python3 - "${STT_FINALIZE_LOCK_SECONDS:-}" "${STT_TRANSCRIBE_TIMEOUT_SECONDS:-}" <<'PY'
import math
import sys

def finite(value, default):
    try:
        parsed = float(value) if value else default
    except (TypeError, ValueError):
        return default
    return parsed if math.isfinite(parsed) and parsed >= 0 else default

lock_budget = min(60.0, finite(sys.argv[1], 10.0))
transcribe_budget = min(300.0, max(0.1, finite(sys.argv[2], 30.0)))
print(max(1, math.ceil((lock_budget + transcribe_budget + 5.0) / 0.25)))
PY
}

process_start_token() {
    local pid="$1"
    local stat
    local fields
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    IFS= read -r stat < "/proc/$pid/stat" || return 1
    fields="${stat##*) }"
    set -- $fields
    [ "$#" -ge 20 ] || return 1
    printf '%s\n' "${20}"
}

process_identity_matches() {
    local pid="$1"
    local expected="$2"
    local current
    current="$(process_start_token "$pid" 2>/dev/null || true)"
    [ -n "$current" ] && [ "$current" = "$expected" ]
}

pid_owned_by_current_user() {
    local pid="$1"
    local uid
    uid="$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')"
    [ "$uid" = "$(id -u)" ]
}

process_parent_pid() {
    ps -o ppid= -p "$1" 2>/dev/null | tr -d ' '
}

children_of() {
    pgrep -P "$1" 2>/dev/null || true
}

PROCESS_TREE=()
collect_process_tree() {
    local pid="$1"
    local token="$2"
    local child
    local child_token
    local children=()

    process_identity_matches "$pid" "$token" || return 0
    pid_owned_by_current_user "$pid" || return 0
    mapfile -t children < <(children_of "$pid")
    for child in "${children[@]}"; do
        [[ "$child" =~ ^[0-9]+$ ]] || continue
        pid_owned_by_current_user "$child" || continue
        [ "$(process_parent_pid "$child")" = "$pid" ] || continue
        child_token="$(process_start_token "$child" 2>/dev/null || true)"
        [ -n "$child_token" ] || continue
        # Revalidate both sides after collecting the child token. This closes
        # the fork/exit/PID-reuse window before recursion.
        process_identity_matches "$pid" "$token" || return 0
        [ "$(process_parent_pid "$child")" = "$pid" ] || continue
        process_identity_matches "$child" "$child_token" || continue
        collect_process_tree "$child" "$child_token"
    done
    process_identity_matches "$pid" "$token" && PROCESS_TREE+=("$pid:$token")
}

signal_validated_records() {
    local signal_name="$1"
    shift
    local record
    local pid
    local token
    for record in "$@"; do
        pid="${record%%:*}"
        token="${record#*:}"
        if pid_owned_by_current_user "$pid" && process_identity_matches "$pid" "$token"; then
            kill "-$signal_name" "$pid" 2>/dev/null || true
        fi
    done
}

records_are_alive() {
    local record
    local pid
    local token
    for record in "$@"; do
        pid="${record%%:*}"
        token="${record#*:}"
        if pid_owned_by_current_user "$pid" && process_identity_matches "$pid" "$token"; then
            return 0
        fi
    done
    return 1
}

refresh_process_records() {
    local record
    local pid
    local token
    local refreshed=()
    local candidate
    local -A seen=()
    for record in "$@"; do
        pid="${record%%:*}"
        token="${record#*:}"
        PROCESS_TREE=()
        collect_process_tree "$pid" "$token"
        for candidate in "${PROCESS_TREE[@]}"; do
            if [ -z "${seen[$candidate]+set}" ]; then
                refreshed+=("$candidate")
                seen[$candidate]=1
            fi
        done
    done
    [ "${#refreshed[@]}" -gt 0 ] && printf '%s\n' "${refreshed[@]}"
}

# Begin stopping the recorder: signal it (and its children) to finalize and
# clear the PID file. This is the only part that must run under the lock so a
# queued press resolves against accurate state. The long finalization wait is
# handled separately by wait_for_finalize, outside the lock.
begin_stop() {
    local pid="$1"
    local token
    pid_is_ours "$pid" || return 1
    token="$(process_start_token "$pid" 2>/dev/null || true)"
    [ -n "$token" ] || return 1
    pid_is_ours "$pid" && process_identity_matches "$pid" "$token" || return 1
    notify_msg "Finishing Dictation" "Stopping capture and transcribing buffered speech" \
        "audio-input-microphone-symbolic" "low"
    PROCESS_TREE=()
    collect_process_tree "$pid" "$token"
    signal_validated_records INT "${PROCESS_TREE[@]}"
    # Clear the slot now, under the lock, while the recorder is still finalizing.
    # A queued press that acquires the lock next finds no PID file but still
    # matches the live recorder via the pgrep fallback (its cmdline keeps
    # faster_whisper_auto for its whole lifetime), so it re-issues a harmless,
    # idempotent stop instead of spawning a brand-new recording.
    rm -f "$PID_FILE"
    printf 'root %s:%s\n' "$pid" "$token"
    printf 'proc %s\n' "${PROCESS_TREE[@]}"
}

# Wait for the recorder to finish finalizing, escalating to TERM/KILL on timeout.
# Must NOT touch the lock: it runs after the lock has been released so a
# hotkey press during finalization is not blocked.
wait_for_finalize() {
    local serialized="$1"
    local kind
    local record
    local root_record=""
    local records=()
    local refreshed=()
    local poll_limit
    local i=0
    while read -r kind record; do
        [ "$kind" = "root" ] && root_record="$record"
        [ "$kind" = "proc" ] && records+=("$record")
    done <<< "$serialized"
    [ -n "$root_record" ] && [ "${#records[@]}" -gt 0 ] || return 1
    poll_limit="$(finalization_wait_polls 2>/dev/null || echo 180)"
    [[ "$poll_limit" =~ ^[0-9]+$ ]] || poll_limit=180

    while [ "$i" -lt "$poll_limit" ]; do
        if ! records_are_alive "${records[@]}"; then
            notify_classic_result
            return $?
        fi
        sleep 0.25
        i=$((i + 1))
    done
    notify_msg "Stopping Dictation" "Finalization timed out; stopping process" \
        "dialog-warning" "normal"
    mapfile -t refreshed < <(refresh_process_records "${records[@]}")
    [ "${#refreshed[@]}" -gt 0 ] && records=("${refreshed[@]}")
    signal_validated_records TERM "${records[@]}"

    # SIGTERM is still handled cooperatively by the recorder. Give it a short
    # final budget, then guarantee a wedged backend cannot survive forever.
    i=0
    while [ "$i" -lt 20 ]; do
        if ! records_are_alive "${records[@]}"; then
            return 1
        fi
        sleep 0.25
        i=$((i + 1))
    done
    mapfile -t refreshed < <(refresh_process_records "${records[@]}")
    [ "${#refreshed[@]}" -gt 0 ] && records=("${refreshed[@]}")
    signal_validated_records KILL "${records[@]}"
    return 1
}

notify_classic_result() {
    local state
    state="$(python3 - "$STATUS_FILE" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    data = {}
print(data.get("state", "") if isinstance(data, dict) else "")
PY
)"
    if [ "$state" = "idle" ]; then
        notify_msg "Dictation Finished" "Buffered speech was finalized" \
            "edit-paste" "low"
        return 0
    fi
    notify_msg "Dictation Failed" "Finalization failed; check $LOG_FILE" \
        "dialog-error" "critical"
    return 1
}

# Parse side-effect-free commands before toggling.
case "${1:-}" in
    -h|--help|help)
        usage
        exit 0
        ;;
    status)
        PID="$(running_pid || true)"
        RUNNING=0
        [ -n "$PID" ] && RUNNING=1
        case "${2:-}" in
            --plain)
                status_plain "$PID" "$RUNNING"
                ;;
            --json)
                status_json "$PID" "$RUNNING"
                ;;
            "")
                if [ "$RUNNING" -eq 1 ]; then
                    echo "$(status_plain "$PID" "$RUNNING") (pid $PID)"
                else
                    status_plain "" 0
                fi
                ;;
            *)
                echo "unknown status option: $2" >&2
                usage >&2
                exit 2
                ;;
        esac
        exit 0
        ;;
    purge-state|purge)
        purge_state
        exit 0
        ;;
    "")
        ;;
    *)
        echo "unknown option or command: $1" >&2
        usage >&2
        exit 2
        ;;
esac

# Serialize the start/stop decision so a rapid double hotkey press can't run
# two toggles concurrently and double-spawn the recorder.
LOCK_FILE="$STATE_DIR/talk2claude-faster.lock"

# Decide whether to start or stop, performing the kill/spawn under the caller's
# lock. On the stop path this only begins the stop (signal + clear PID file) and
# prints the recorder PID so the caller can wait for finalization *after*
# releasing the lock. On the start path it spawns the recorder and prints
# nothing.
toggle_action() {
    local pid
    # Check if already running
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE" 2>/dev/null || echo "")"
        if [ -n "$pid" ] && pid_is_ours "$pid"; then
            # Running - begin stop under the lock; caller waits outside it.
            begin_stop "$pid"
            return 0
        fi
        # PID file exists but process dead - clean up
        rm -f "$PID_FILE"
    fi

    # Also check for a same-user process from this project without a PID file.
    while IFS= read -r pid; do
        if pid_is_ours "$pid"; then
            begin_stop "$pid"
            return 0
        fi
    done < <(pgrep -u "$(id -u)" -f "faster_whisper_(auto|clipboard|typing)" 2>/dev/null || true)

    # Check clipboard tool availability
    local clipboard_tool=""
    if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
        if command -v wl-copy >/dev/null 2>&1; then
            clipboard_tool="wl-copy"
        else
            notify_msg "Install Clipboard Tool" "Run: sudo apt install wl-clipboard" \
                "dialog-information" "normal"
            # Continue anyway - will use fallback
        fi
    else
        # X11
        if command -v xclip >/dev/null 2>&1; then
            clipboard_tool="xclip"
        elif command -v xsel >/dev/null 2>&1; then
            clipboard_tool="xsel"
        else
            notify_msg "Install Clipboard Tool" "Run: sudo apt install xclip" \
                "dialog-information" "normal"
            # Continue anyway - will use fallback
        fi
    fi

    # Not running - start it
    notify_msg "Starting Real-time Dictation" \
        "Speak and text will copy to clipboard. Paste with Ctrl+V." \
        "audio-input-microphone-high-symbolic" "normal"

    # Python environment
    if ! command -v uv >/dev/null 2>&1; then
        notify_msg "Error" "uv not found. Run installer.sh --with-stt" \
            "dialog-error" "critical"
        return 1
    fi

    rm -f "$STATUS_FILE"
    cd "$PROJECT_ROOT" || {
        echo "Project root not found: $PROJECT_ROOT" >&2
        return 1
    }
    # Clipboard is the safe default; direct typing is explicit opt-in.
    local child
    STT_STOP_HINT="Press the dictation hotkey again to stop and transcribe" \
        nohup uv --project "$PROJECT_ROOT" run --extra stt python -m src.stt.faster_whisper_auto --clipboard > "$LOG_FILE" 2>&1 &
    child=$!
    echo "$child" > "$PID_FILE"

    # Confirm startup off the critical path so the lock is released promptly.
    (
        # Give it a moment to start
        sleep 2
        if ps -p "$child" > /dev/null 2>&1; then
            if [ -n "$clipboard_tool" ]; then
                notify_msg "Dictation Active - Clipboard Mode" \
                    "Speak → Text copies to clipboard → Paste anywhere with Ctrl+V" \
                    "edit-paste" "low"
            elif [[ "${STT_TRANSCRIPT_FALLBACK:-}" =~ ^(1|true|yes|on)$ ]]; then
                notify_msg "Dictation Active - File Fallback" \
                    "Latest transcript writes to $DICTATION_FILE" \
                    "document-save" "low"
            else
                notify_msg "Dictation Active - Clipboard Tool Missing" \
                    "Install wl-clipboard/xclip or set STT_TRANSCRIPT_FALLBACK=1" \
                    "dialog-information" "normal"
            fi
        else
            notify_msg "Failed to Start" "Check $LOG_FILE for errors" \
                "dialog-error" "critical"
            # Only clear the slot if it still points at this failed child.
            if [ "$(cat "$PID_FILE" 2>/dev/null || echo)" = "$child" ]; then
                rm -f "$PID_FILE"
            fi
        fi
    # Detach the confirmation subshell from the caller's stdout so it does not
    # keep a command-substitution pipe open (which would otherwise stall
    # $(toggle_action) for the full 2s startup-confirm window).
    ) >/dev/null 2>&1 &
}

# Run the start/stop decision and the spawn/kill under an exclusive flock when
# available; degrade to running it directly when util-linux flock is absent.
# The lock is released BEFORE the bounded finalization wait so a hotkey press
# during finalization is resolved against accurate state (it sees the recorder
# still finalizing) instead of queuing behind the wait and starting fresh.
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    flock 9
    stop_target="$(toggle_action)"
    flock -u 9
    [ -n "$stop_target" ] && wait_for_finalize "$stop_target"
else
    stop_target="$(toggle_action)"
    [ -n "$stop_target" ] && wait_for_finalize "$stop_target"
fi
